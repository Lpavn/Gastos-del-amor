# --- Supabase (Dashboard > Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Google Gemini (aistudio.google.com > Get API key) — nivel gratuito ---
# Se usa SOLO en el servidor (ruta /api/parse-receipt) para leer las fotos de tickets.
# NUNCA le pongas el prefijo NEXT_PUBLIC_ a esta, o quedaría expuesta en el navegador.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# --- Nombres de los dos integrantes ---
NEXT_PUBLIC_PERSON_1_NAME=Kiara
NEXT_PUBLIC_PERSON_2_NAME=Pareja

# --- PIN opcional para proteger el acceso a la app (dejalo vacío para desactivarlo) ---
NEXT_PUBLIC_APP_PIN=1234

# --- Carga automática por mail (opcional, ver README > "Carga automática por mail") ---
IMPORT_SECRET=casa2026-xk93jd-secreto
EMAIL_IMPORT_PERSON=Kiara

# Alias/CBU que Luca y Kiara usan para transferirse plata ENTRE ELLOS
# (separados por coma). Cualquier transferencia enviada o recibida hacia/desde
# uno de estos valores se ignora: no se guarda como gasto ni como ingreso,
# porque es plata que se mueve dentro de la pareja, no un movimiento real.
INTERNAL_TRANSFER_ALIASES=lucapavon,0000003100028792496070

# --- Bot de Telegram (opcional, ver README > "Bot de Telegram") ---
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=otro-texto-largo-y-raro
TELEGRAM_CHAT_ID_PERSON_1=
TELEGRAM_CHAT_ID_PERSON_2=

# Inventá cualquier texto largo acá; Vercel Cron lo manda solo como header al
# llamar a /api/telegram-remind, no hay que hacer nada más con este valor.
CRON_SECRET=otro-texto-largo-y-raro-2
